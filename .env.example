# Yahoo Fantasy Sports API — server-side only, never exposed to the client.
# Copy this file to `.env` and fill in the values from your Yahoo app
# (developer.yahoo.com/apps). The `.env` file is gitignored.

# From the Yahoo app page after you click "Create App":
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Must EXACTLY match the Redirect URI you set on the Yahoo app form.
YAHOO_REDIRECT_URI=https://localhost:4000/api/yahoo/callback

# Filled in automatically by the one-time auth CLI (`npm run yahoo:auth`).
# This long-lived token is what lets the server refresh access without re-login.
YAHOO_REFRESH_TOKEN=
