{
  "name": "@draft/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "yahoo:auth": "tsx src/yahoo/auth-cli.ts",
    "yahoo:sync": "tsx src/yahoo/sync.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "nanoid": "^5.0.9",
    "pg": "^8.23.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
